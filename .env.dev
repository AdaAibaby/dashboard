### =================================
### REQUIRED SERVER ENVIRONMENT VARIABLES
### =================================

### Your self-hosted E2B Infrastructure API URL
INFRA_API_URL=http://192.168.162.30:3000
# INFRA_API_URL=http://127.0.0.1:3004

### Default domain for the E2B SDK
### Used for Sandbox Details Page
NEXT_PUBLIC_E2B_DOMAIN=dev-e2b.xiaobei.top

### E2B API URL and Key for SDK operations
### These are required for the Sandbox Inspect feature to work
NEXT_PUBLIC_E2B_API_URL=http://14.103.183.251:3000
NEXT_PUBLIC_E2B_API_KEY=e2b_e2b53ae1fed82754c17ad8077f
NEXT_PUBLIC_E2B_FORCE_HTTP=1

# Authentication configuration
### Set to 1 to enable authentication for all API requests
ENABLE_AUTH=1
NEXT_PUBLIC_HOST=http://14.103.183.251:3003
NEXT_PUBLIC_URL=http://14.103.183.251:3003


### KV database configuration
KV_URL=redis://10.128.52.156:6379
KV_REST_API_TOKEN=test-api-token
KV_REST_API_URL=https://10.128.52.156:6379

### =================================
### OPTIONAL SERVER ENVIRONMENT VARIABLES
### =================================

### Billing API URL (Required if NEXT_PUBLIC_INCLUDE_BILLING=1)
### Enable billing features: set to 1 to enable
### When enabled, both BILLING_API_URL and NEXT_PUBLIC_STRIPE_BILLING_URL must be provided
BILLING_API_URL=https://billing.e2b.dev
NEXT_PUBLIC_INCLUDE_BILLING=1
NEXT_PUBLIC_STRIPE_BILLING_URL=https://billing.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_12345678901234567890

### Vercel URL (automatically set in Vercel deployments)
