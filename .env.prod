### =================================
### REQUIRED SERVER ENVIRONMENT VARIABLES
### =================================

### Your self-hosted E2B Infrastructure API URL
INFRA_API_URL=http://192.168.162.20:3000

### Default domain for the E2B SDK
### Used for Sandbox Details Page
NEXT_PUBLIC_E2B_DOMAIN=prod-e2b.xiaobei.top
#NEXT_PUBLIC_E2B_DOMAIN=192.168.162.20.nip.io

### E2B API URL and Key for SDK operations
### These are required for the Sandbox Inspect feature to work
NEXT_PUBLIC_E2B_API_URL=http://192.168.162.20:3000
NEXT_PUBLIC_INFRA_API_URL=http://192.168.162.20:3000
#NEXT_PUBLIC_INFRA_API_URL=http://14.103.209.238:3000
#NEXT_PUBLIC_E2B_API_KEY=e2b_0c420ffcbbd093c849d00802248c18daad77e6c4
#NEXT_PUBLIC_E2B_API_KEY=e2b_747ee7d44f3cd266eb06d1e93d11d53a18ed
NEXT_PUBLIC_E2B_API_KEY=e2b_58a2f56000ef9074913f427ab0f7151c5f21
NEXT_PUBLIC_E2B_FORCE_HTTP=1

# Authentication configuration
### Set to 1 to enable authentication for all API requests
ENABLE_AUTH=1
NEXT_PUBLIC_HOST=http://14.103.209.238:3003
NEXT_PUBLIC_URL=http://14.103.209.238:3003
### Authentication cookie configuration
FORCE_SECURE_COOKIE=false
### KV database configuration
KV_URL=redis://192.168.161.254:6379
KV_REST_API_TOKEN=test-api-token
KV_REST_API_URL=https://192.168.161.254:6379

### =================================
### OPTIONAL SERVER ENVIRONMENT VARIABLES
### =================================

### Billing API URL (Required if NEXT_PUBLIC_INCLUDE_BILLING=1)
### Enable billing features: set to 1 to enable
### When enabled, both BILLING_API_URL and NEXT_PUBLIC_STRIPE_BILLING_URL must be provided
BILLING_API_URL=https://billing.e2b.dev
NEXT_PUBLIC_INCLUDE_BILLING=1
NEXT_PUBLIC_STRIPE_BILLING_URL=https://billing.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_12345678901234567890

### Vercel URL (automatically set in Vercel deployments)
# VERCEL_URL=

### PostgreSQL 连接配置
POSTGRES_HOST=192.168.162.24
POSTGRES_PORT=5432
POSTGRES_USER=e2b
POSTGRES_PASSWORD=Galaxy123
POSTGRES_DATABASE=e2b-prod-pg

### OTEL Service Name
# OTEL_SERVICE_NAME=

### ZeroBounce API key for email validation
# ZEROBOUNCE_API_KEY=

### Loki Configuration
# LOKI_SERVICE_NAME=
# LOKI_HOST=
# LOKI_USERNAME=
# LOKI_PASSWORD=

### OTEL Configuration
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_EXPORTER=
# OTEL_METRICS_EXPORTER=
# OTEL_LOGS_EXPORTER=
# OTEL_NODE_RESOURCE_DETECTORS=
# OTEL_RESOURCE_ATTRIBUTES=


